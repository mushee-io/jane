PORT=8787
HOST=0.0.0.0
RATE_LIMIT_PER_MINUTE=120
JANE_PUBLIC_URL=http://localhost:8787

# At least one provider is required for live inference.
# Routing/price preview works without keys.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_REASON_MODEL=gpt-5-mini
OPENAI_INPUT_COST_PER_M=0.25
OPENAI_OUTPUT_COST_PER_M=2
OPENAI_ZERO_RETENTION=false

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_FAST_MODEL=openai/gpt-oss-120b
GROQ_INPUT_COST_PER_M=0.15
GROQ_OUTPUT_COST_PER_M=0.60
GROQ_ZERO_RETENTION=false

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_ECONOMY_MODEL=qwen/qwen3-30b-a3b
OPENROUTER_INPUT_COST_PER_M=0.10
OPENROUTER_OUTPUT_COST_PER_M=0.30
OPENROUTER_ZERO_RETENTION=false

# Optional OpenAI-compatible confidential/zero-retention endpoint.
JANE_PRIVATE_BASE_URL=
JANE_PRIVATE_API_KEY=
JANE_PRIVATE_MODEL=
JANE_PRIVATE_INPUT_COST_PER_M=0.40
JANE_PRIVATE_OUTPUT_COST_PER_M=1.20


# --- M11 OpenAI-compatible API ---
# Optional comma-separated Bearer keys. Leave blank for open alpha access.
JANE_API_KEYS=

# --- M12 failover ---
JANE_PROVIDER_TIMEOUT_MS=30000
JANE_CIRCUIT_FAILURE_THRESHOLD=3
JANE_CIRCUIT_COOLDOWN_MS=30000

# --- M14/M15 Monad settlement ---
# Keep chain/RPC/contract addresses environment-driven so testnet/mainnet can be swapped safely.
MONAD_RPC_URL=
MONAD_CHAIN_ID=
MONAD_SETTLEMENT_CONTRACT=
MONAD_PROVIDER_TREASURY=

# Recommended: a USD stablecoin settlement token.
# Set zero address only for a native-token demo.
MONAD_SETTLEMENT_TOKEN=
MONAD_SETTLEMENT_TOKEN_DECIMALS=6
MONAD_SETTLEMENT_TOKEN_SYMBOL=USDC


# Local deployment helper only. Never expose this in the browser.
MONAD_DEPLOYER_PRIVATE_KEY=


# --- M16 Agent Accounts ---
# Optional bootstrap JSON array. Admin mutations require JANE_ADMIN_KEY.
JANE_AGENT_ACCOUNTS_JSON=
JANE_ADMIN_KEY=

# --- M17/M22 Provider Marketplace + Open Compute Network ---
# Optional bootstrap JSON array of approved provider manifests.
JANE_NETWORK_PROVIDERS_JSON=
# Comma-separated host allowlist. Leave blank to permit HTTPS endpoints in the alpha.
JANE_NETWORK_ALLOWED_HOSTS=
JANE_NETWORK_HEARTBEAT_STALE_MS=300000

# --- M18 33jane-owned inference ---
JANE_COMPUTE_BASE_URL=
JANE_COMPUTE_API_KEY=
JANE_COMPUTE_MODEL=
JANE_COMPUTE_CONTEXT_WINDOW=131072
JANE_COMPUTE_INPUT_COST_PER_M=0.08
JANE_COMPUTE_OUTPUT_COST_PER_M=0.24
JANE_COMPUTE_QUALITY_SCORE=0.82
JANE_COMPUTE_LATENCY_SCORE=0.86
JANE_COMPUTE_PRIVACY_SCORE=0.92
JANE_COMPUTE_ZERO_RETENTION=true

# --- M20 Enterprise Gateway ---
# JSON array of organization policies.
JANE_ENTERPRISE_ORGS_JSON=

# --- M21 33G utility adapter ---
# Chain is intentionally configurable because final 33G deployment chain can be chosen later.
JANE_TOKEN_RPC_URL=
JANE_TOKEN_CHAIN_ID=
JANE_33G_TOKEN_CONTRACT=
JANE_33G_STAKING_CONTRACT=

# --- Generic contract deployment helper ---
DEPLOY_RPC_URL=
DEPLOY_CHAIN_ID=
DEPLOY_CHAIN_NAME=
DEPLOY_NATIVE_SYMBOL=
DEPLOYER_PRIVATE_KEY=
DEPLOY_CONTRACT=
DEPLOY_ARGS_JSON=


# --- M16 onchain agent wallet factory (Monad) ---
MONAD_AGENT_WALLET_FACTORY=

# --- M22 bonded compute registry (Monad) ---
MONAD_COMPUTE_REGISTRY=
MONAD_COMPUTE_MIN_BOND=0.01
