{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/jane",
      "destination": "/jane.html"
    },
    {
      "source": "/clearing",
      "destination": "/clearing/index.html"
    },
    {
      "source": "/api/ai/health",
      "destination": "/api/ai-health"
    },
    {
      "source": "/api/ai/chat",
      "destination": "/api/ai-chat"
    },
    {
      "source": "/api/media/generate",
      "destination": "/api/media-generate"
    },
    {
      "source": "/api/media/status",
      "destination": "/api/media-status"
    },
    {
      "source": "/v1/:path*",
      "destination": "/api/index?v1=:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index?path=:path*"
    }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 30
    },
    "api/ai-health.ts": {
      "maxDuration": 30
    },
    "api/ai-chat.ts": {
      "maxDuration": 30
    },
    "api/media-generate.ts": {
      "maxDuration": 60
    },
    "api/media-status.ts": {
      "maxDuration": 30
    }
  }
}
