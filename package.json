{
  "name": "33jane",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Private multi-model AI router, price optimizer and local privacy firewall",
  "scripts": {
    "dev": "tsx watch src/api/server.ts",
    "start": "tsx src/api/server.ts",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/**/*.test.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-static.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run compile:contracts && npm run build",
    "compile:contracts": "node scripts/compile-contracts.mjs",
    "deploy:monad-settlement": "node scripts/deploy-settlement.mjs",
    "deploy:contract": "node scripts/deploy-contract.mjs"
  },
  "dependencies": {
    "zod": "^3.25.76",
    "viem": "^2.37.13"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "solc": "^0.8.30"
  }
}
