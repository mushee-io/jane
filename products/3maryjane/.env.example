MONAD_MAINNET_RPC=https://rpc.monad.xyz
MONAD_TESTNET_RPC=https://testnet-rpc.monad.xyz
PRIVATE_KEY=

# Production Metropolis decision: full CL demo targets Monad mainnet (143), because the
# verified Euler integration is mainnet-only in this repository. Testnet remains useful for
# Kuru + Perpl dry-runs, but must not pretend Euler exists there.
CL_DEMO_CHAIN_ID=143

# Core deployment / configuration
ADAPTER_REGISTRY=
KURU_ADAPTER=
PERPL_ADAPTER=
EULER_ADAPTER=
WALLET_BALANCE_ADAPTER=

# Kuru integration. CSV values are consumed by Foundry deployment/config scripts.
KURU_MARGIN_ACCOUNT=
KURU_TRACKED_TOKENS=
KURU_MARKETS=

# Perpl integration
PERPL_EXCHANGE=
PERPL_COLLATERAL=
PERPL_TRACKED_PERP_IDS=

# Euler integration (full demo: Monad mainnet only unless a deployment is independently verified).
EULER_EVC=
EULER_TRACKED_VAULTS=

# Assets held directly by the CL Account that must remain visible to the risk engine.
FREE_COLLATERAL_ASSETS=

# RiskRegistry configuration for the primary Metropolis underlying + collateral pair.
# Feed addresses must be Chainlink-compatible and re-verified on the selected Monad network.
RISK_REGISTRY=
RISK_UNDERLYING_ASSET=
RISK_UNDERLYING_FEED=
# Testnet dry-run only. Used by TestnetManualPriceSource; not a production oracle.
RISK_UNDERLYING_PRICE_E18=
RISK_UNDERLYING_DECIMALS=18
RISK_UNDERLYING_INITIAL_MARGIN_BPS=2000
RISK_UNDERLYING_MAINTENANCE_MARGIN_BPS=1200
RISK_UNDERLYING_HEDGE_MARGIN_BPS=300
RISK_UNDERLYING_STRESS_BPS=2000
RISK_UNDERLYING_MAX_STALENESS=3600
RISK_COLLATERAL_ASSET=
RISK_COLLATERAL_FEED=
# Testnet dry-run only. Used by TestnetManualPriceSource; not a production oracle.
RISK_COLLATERAL_PRICE_E18=
RISK_COLLATERAL_DECIMALS=18
RISK_COLLATERAL_INITIAL_MARGIN_BPS=100
RISK_COLLATERAL_MAINTENANCE_MARGIN_BPS=50
RISK_COLLATERAL_HEDGE_MARGIN_BPS=50
RISK_COLLATERAL_STRESS_BPS=300
RISK_COLLATERAL_MAX_STALENESS=3600
# Perpl unit configuration is protocol-specific and must be verified before broadcast.
RISK_PERPL_EXPOSURE_DECIMALS=0
RISK_PERPL_COLLATERAL_DECIMALS=6
RISK_PERPL_PNL_DECIMALS=6

# Deterministic CL Account initialization.
# CL_ACCOUNT_SALT must be a 32-byte hex value, e.g. 0x...64 hex chars.
CL_ACCOUNT_SALT=
CL_ALLOWED_ASSETS=
# Filled after InitializeDemoAccount.s.sol emits the account address.
CL_ACCOUNT=
CL_ACCOUNT_OWNER=
# Policy values are USD WAD (1e18) unless noted otherwise.
CL_POLICY_MAX_GROSS_USD_E18=25000000000000000000000
CL_POLICY_MAX_DEBT_USD_E18=5000000000000000000000
CL_POLICY_MAX_LEVERAGE_E18=2000000000000000000
CL_POLICY_MAX_MARGIN_UTILIZATION_E18=700000000000000000
CL_POLICY_MIN_HEALTH_E18=1500000000000000000
CL_POLICY_MIN_CRITICAL_MOVE_BPS=1500

# Final deployment evidence. Populate these only with confirmed hashes from the intended chain.
GIT_COMMIT_SHA=
DEMO_TX_FUNDING=
DEMO_TX_KURU=
DEMO_TX_PERPL=
DEMO_TX_EULER=
DEMO_TX_POLICY_REVERT=
DEMO_TX_DEFENSE=

# Public Risk API — production demo defaults to Monad mainnet.
CL_CHAIN_ID=143
CL_RPC_URL=https://rpc.monad.xyz
CL_ACCOUNT_FACTORY=
CL_ADAPTER_REGISTRY=
CL_RISK_REGISTRY=
CL_RISK_ENGINE=
CL_RISK_POLICY_MANAGER=
CL_RISK_SOLVER=
CL_INTENT_ENGINE=
CL_CAPITAL_ROUTER=
CL_MULTI_STEP_PLANNER=
CL_DEFENSIVE_EXECUTOR=
CL_KEEPER_NETWORK=
CL_SIMULATION_ENGINE=
CL_KURU_ADAPTER=
CL_PERPL_ADAPTER=
CL_EULER_ADAPTER=
CL_WALLET_BALANCE_ADAPTER=
PORT=8787

# CL Terminal (Vite exposes only VITE_* values to the browser; never put PRIVATE_KEY here)
VITE_CL_CHAIN_ID=143
VITE_CL_RPC_URL=https://rpc.monad.xyz
VITE_CL_ACCOUNT_FACTORY=
VITE_CL_ADAPTER_REGISTRY=
VITE_CL_RISK_REGISTRY=
VITE_CL_RISK_ENGINE=
VITE_CL_RISK_POLICY_MANAGER=
VITE_CL_RISK_SOLVER=
VITE_CL_INTENT_ENGINE=
VITE_CL_CAPITAL_ROUTER=
VITE_CL_MULTI_STEP_PLANNER=
VITE_CL_DEFENSIVE_EXECUTOR=
VITE_CL_KEEPER_NETWORK=
VITE_CL_SIMULATION_ENGINE=
VITE_CL_KURU_ADAPTER=
VITE_CL_PERPL_ADAPTER=
VITE_CL_EULER_ADAPTER=
VITE_CL_WALLET_BALANCE_ADAPTER=
